{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Folder for the SQLite database (notes, images, accounts and data-protection keys all live in one file).
  // Relative paths are resolved against the app folder. Defaults to ./App_Data.
  "DataDirectory": "",

  // Optional full SQLite connection string; overrides DataDirectory when set.
  "ConnectionStrings": {
    "Default": ""
  },

  "Auth": {
    // FirstUserOnly (default): only the first account can be created - ideal for a personal notes server.
    // Open: anyone can register (each account only sees its own notes). Closed: no new accounts.
    "Registration": "FirstUserOnly",
    // How long a browser stays signed in without being used (sliding expiration).
    "SessionDays": 60
  },

  "Passkeys": {
    // The WebAuthn relying party ID. Leave empty to use the host name the app is reached on.
    // Set it (e.g. "notes.example.com") if the app is reachable under several host names.
    "ServerDomain": ""
  }
}
