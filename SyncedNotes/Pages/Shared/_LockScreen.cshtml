<div id="lockScreen" class="lock-screen" hidden role="dialog" aria-modal="true" aria-labelledby="lockTitle">
    <div class="lock-card">
        <img src="/icons/icon.svg" class="lock-icon" alt="" />
        <h1 id="lockTitle"><i class="bi bi-lock-fill"></i> SyncedNotes is locked</h1>
        <p class="who" id="lockUser"></p>

        <div id="lockError" class="alert alert-danger py-2 small" role="alert" hidden></div>
        <div id="lockInfo" class="alert alert-info py-2 small" hidden></div>

        <button type="button" class="btn btn-primary btn-lg w-100" id="btnUnlockPasskey">
            <i class="bi bi-fingerprint me-1"></i> Unlock with passkey
        </button>

        <div id="pinSection" hidden>
            <div class="lock-divider">or</div>
            <form id="pinForm" autocomplete="off">
                <label for="pinInput" class="visually-hidden">PIN</label>
                <input id="pinInput" class="form-control form-control-lg pin-input" type="password" inputmode="numeric"
                       pattern="[0-9]*" maxlength="12" placeholder="PIN" autocomplete="off" />
                <button type="submit" class="btn btn-outline-secondary w-100 mt-2" id="btnUnlockPin">Unlock with PIN</button>
            </form>
        </div>

        <button type="button" class="btn btn-link btn-sm mt-4 text-body-secondary" id="btnLockSignOut">Sign out instead</button>
    </div>
</div>
