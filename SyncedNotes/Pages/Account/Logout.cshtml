@page
@model SyncedNotes.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Sign out";
}

<h1 class="auth-title">Sign out?</h1>
<p class="auth-subtitle">You'll need your passkey to sign in again.</p>
<form method="post">
    <button type="submit" class="btn btn-primary btn-lg w-100">Sign out</button>
</form>
<div class="auth-links"><a href="/">Back to my notes</a></div>
