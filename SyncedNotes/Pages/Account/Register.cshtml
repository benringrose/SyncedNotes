@page
@model SyncedNotes.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
}

@if (!Model.RegistrationOpen)
{
    <h1 class="auth-title">Registration is closed</h1>
    <p class="auth-subtitle">This SyncedNotes server already has an owner and isn't accepting new accounts.</p>
    <a class="btn btn-primary w-100" href="/Account/Login">Go to sign in</a>
}
else
{
    <div id="registerStep">
        <h1 class="auth-title">@(Model.FirstUser ? "Set up SyncedNotes" : "Create your account")</h1>
        <p class="auth-subtitle">
            No passwords: your account is protected by a passkey – Windows Hello, Touch ID, Face ID,
            your phone or a security key.
        </p>

        <div id="authAlert" class="alert d-none" role="alert" aria-live="polite"></div>
        <div id="unsupported" class="alert alert-warning d-none">
            This browser doesn't support passkeys. Try a recent version of Edge, Chrome, Safari or Firefox.
        </div>

        <form id="registerForm" novalidate>
            <div class="mb-3">
                <label for="userName" class="form-label">Username</label>
                <input id="userName" class="form-control" required autocomplete="username" autocapitalize="none"
                       spellcheck="false" maxlength="64" placeholder="e.g. alex" />
                <div class="form-text">Letters, numbers and . _ - @@ +</div>
            </div>
            <div class="mb-4">
                <label for="displayName" class="form-label">Display name <span class="text-body-secondary small">(optional)</span></label>
                <input id="displayName" class="form-control" autocomplete="name" maxlength="64" placeholder="Alex Smith" />
            </div>
            <button type="submit" id="btnRegister" class="btn btn-primary btn-lg w-100">
                <i class="bi bi-person-plus me-1"></i> Create account with a passkey
            </button>
        </form>
        <div class="auth-links">
            @if (!Model.FirstUser)
            {
                <a href="/Account/Login">Already have an account? Sign in</a>
            }
        </div>
    </div>

    <div id="recoveryStep" class="d-none">
        <h1 class="auth-title"><i class="bi bi-shield-check text-success"></i> You're all set</h1>
        <p class="auth-subtitle">
            Save these <strong>recovery codes</strong> somewhere safe. If you ever lose access to your passkeys,
            each code lets you sign in once so you can add a new passkey.
        </p>
        <ol id="recoveryCodeList" class="recovery-codes"></ol>
        <div class="d-flex gap-2 mb-3">
            <button type="button" class="btn btn-outline-secondary flex-fill" id="btnCopyCodes"><i class="bi bi-clipboard"></i> Copy</button>
            <button type="button" class="btn btn-outline-secondary flex-fill" id="btnDownloadCodes"><i class="bi bi-download"></i> Download</button>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="savedCodes" />
            <label class="form-check-label" for="savedCodes">I've saved my recovery codes</label>
        </div>
        <button type="button" class="btn btn-primary btn-lg w-100" id="btnContinue" disabled>Open my notes</button>
    </div>
}
