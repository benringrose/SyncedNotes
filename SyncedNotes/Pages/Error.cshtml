@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="auth-title"><i class="bi bi-exclamation-triangle text-warning"></i> Something went wrong</h1>
<p class="auth-subtitle">An unexpected error occurred while processing your request.</p>
@if (Model.ShowRequestId)
{
    <p class="small text-body-secondary">Request ID: <code>@Model.RequestId</code></p>
}
<a class="btn btn-primary w-100" href="/">Back to my notes</a>
