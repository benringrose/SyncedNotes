# Copy this file to .env and fill it in. Keep .env private: it holds your access tokens.

# A GitHub personal access token that can read the repository. Create a fine-grained token at
# https://github.com/settings/personal-access-tokens/new with access to only this repository and the
# "Contents: Read-only" permission.
GIT_PAT=

# The repository, and the branch, tag or commit to build.
GIT_REPOSITORY=https://github.com/benringrose/SyncedNotes.git
GIT_REF=main

# The token of your Cloudflare Tunnel: the long string starting with "eyJ" in the install command that the Cloudflare
# dashboard shows for the tunnel. Anyone with it can run the tunnel and take over its traffic, so treat it like a
# password.
TUNNEL_TOKEN=

# The public host name that the tunnel routes to the app, such as notes.example.com. Passkeys are tied to it, so set
# it before you create your account.
DOMAIN=

# FirstUserOnly, Open (anyone can create an account, and each sees only their own notes) or Closed.
REGISTRATION=FirstUserOnly
