# Copy this file to .env and fill it in. Keep .env private: it holds your access token.

# A GitHub personal access token that can read the repository. Create a fine-grained token at
# https://github.com/settings/personal-access-tokens/new with access to only this repository and the
# "Contents: Read-only" permission.
GIT_PAT=

# The repository, and the branch, tag or commit to build.
GIT_REPOSITORY=https://github.com/benringrose/SyncedNotes.git
GIT_REF=main

# The public host name, such as notes.example.com. Passkeys are tied to it, so set it before you create your account.
# With --profile https, Caddy gets a certificate for it. Leave it empty to try the app on http://localhost:8080.
DOMAIN=

# FirstUserOnly, Open (anyone can create an account, and each sees only their own notes) or Closed.
REGISTRATION=FirstUserOnly

# The port on this machine where the app listens. It accepts connections from this machine only.
HTTP_PORT=8080
